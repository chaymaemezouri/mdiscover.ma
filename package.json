{
  "name": "mdiscoverma",
  "private": true,
  "description": "Mdiscover Impex Food — monorepo backend + frontend",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "migrate": "npm --prefix backend run prisma:migrate:deploy",
    "seed": "npm --prefix backend run prisma:seed",
    "generate": "npm --prefix backend run prisma:generate",
    "dev:api": "npm --prefix backend run start:dev",
    "dev:web": "npm --prefix frontend run dev",
    "build:api": "npm --prefix backend run build",
    "build:web": "npm --prefix frontend run build"
  }
}
