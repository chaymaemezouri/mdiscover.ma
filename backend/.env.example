# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=api/v1

# PostgreSQL (Docker Compose service "postgres")
POSTGRES_USER=mdiscover
POSTGRES_PASSWORD=mdiscover_secret
POSTGRES_DB=mdiscover
# Port hôte 55432 (évite conflits avec d'autres PostgreSQL locaux)
DATABASE_URL=postgresql://mdiscover:mdiscover_secret@localhost:55432/mdiscover?schema=public

# Redis (optionnel — cache / queues plus tard)
REDIS_URL=redis://localhost:6379

# JWT (ne jamais committer les vraies valeurs de production)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars!
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# Seed comptes internes (dev uniquement)
SEED_ADMIN_EMAIL=admin@mdiscover.ma
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEV_EMAIL=dev@mdiscover.ma
SEED_DEV_PASSWORD=Dev12345!

# Uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=uploads

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Fiscalité (TVA Maroc %)
TAX_RATE=20

# CMI (stub / test — remplacer par le contrat réel)
CMI_CLIENT_ID=mdiscover_test
CMI_STORE_KEY=cmi_test_store_key_change_me
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# Coordonnées virement
BANK_NAME=Banque Populaire
BANK_IBAN=MA640007XXXXXXXXXXXXXX
BANK_RIB=007XXXXXXXXXXXXXX
BANK_ACCOUNT_NAME=Mdiscover Impex Food

# Retours (jours après livraison)
RETURN_WINDOW_DAYS=14

# Emails transactionnels (SMTP cPanel @mdiscover.ma)
MAIL_HOST=mail.mdiscover.ma
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=contact@mdiscover.ma
MAIL_PASS=
MAIL_FROM=MDiscover <contact@mdiscover.ma>
# Routage des alertes
MAIL_CONTACT=contact@mdiscover.ma
MAIL_VENTES=ventes@mdiscover.ma
MAIL_SALES=sales@mdiscover.ma
