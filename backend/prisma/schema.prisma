// Mdiscover Impex Food — schéma Prisma
// Étape 2 : Auth & Users (+ system_settings étape 1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEVELOPER
  CUSTOMER_INDIVIDUAL
  CUSTOMER_PRO
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum ProValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  BILLING
  SHIPPING
}

enum Locale {
  FR
  EN
}

enum PurchaseMode {
  DIRECT
  QUOTE
  HYBRID
}

/// Paramètres applicatifs
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  locale       Locale     @default(FR)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  individualProfile   IndividualProfile?
  professionalProfile ProfessionalProfile?
  addresses           Address[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  carts               Cart[]
  orders              Order[]
  quotes              Quote[]
  returns             ReturnRequest[]
  reviews             Review[]
  favorites           Favorite[]
  stockAlerts         StockAlert[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model IndividualProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

model ProfessionalProfile {
  id               String              @id @default(cuid())
  userId           String              @unique @map("user_id")
  companyName      String              @map("company_name")
  sector           String?
  taxId            String?             @map("tax_id")
  ice              String?
  tradeRegister    String?             @map("trade_register")
  contactPerson    String              @map("contact_person")
  billingAddress   String?             @map("billing_address")
  documentUrls     String[]            @default([]) @map("document_urls")
  validationStatus ProValidationStatus @default(PENDING) @map("validation_status")
  validatedAt      DateTime?           @map("validated_at")
  validatedById    String?             @map("validated_by_id")
  rejectionReason  String?             @map("rejection_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([validationStatus])
  @@map("professional_profiles")
}

model Address {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  type       AddressType @default(SHIPPING)
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?     @map("postal_code")
  country    String      @default("MA")
  phone      String?
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id              String   @id @default(cuid())
  parentId        String?  @map("parent_id")
  slugFr          String   @unique @map("slug_fr")
  slugEn          String   @unique @map("slug_en")
  nameFr          String   @map("name_fr")
  nameEn          String   @map("name_en")
  descriptionFr   String?  @map("description_fr")
  descriptionEn   String?  @map("description_en")
  imageUrl        String?  @map("image_url")
  imageAltFr      String?  @map("image_alt_fr")
  imageAltEn      String?  @map("image_alt_en")
  seoTitleFr      String?  @map("seo_title_fr")
  seoTitleEn      String?  @map("seo_title_en")
  seoDescriptionFr String? @map("seo_description_fr")
  seoDescriptionEn String? @map("seo_description_en")
  isActive        Boolean  @default(true) @map("is_active")
  featuredOnHome  Boolean  @default(false) @map("featured_on_home")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Brand {
  id               String   @id @default(cuid())
  slugFr           String   @unique @map("slug_fr")
  slugEn           String   @unique @map("slug_en")
  name             String
  descriptionFr    String?  @map("description_fr")
  descriptionEn    String?  @map("description_en")
  logoUrl          String?  @map("logo_url")
  bannerUrl        String?  @map("banner_url")
  catalogPdfUrl    String?  @map("catalog_pdf_url")
  seoTitleFr       String?  @map("seo_title_fr")
  seoTitleEn       String?  @map("seo_title_en")
  seoDescriptionFr String?  @map("seo_description_fr")
  seoDescriptionEn String?  @map("seo_description_en")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model Product {
  id                 String       @id @default(cuid())
  brandId            String?      @map("brand_id")
  categoryId         String       @map("category_id")
  sku                String       @unique
  slugFr             String       @unique @map("slug_fr")
  slugEn             String       @unique @map("slug_en")
  nameFr             String       @map("name_fr")
  nameEn             String       @map("name_en")
  descriptionFr      String?      @map("description_fr")
  descriptionEn      String?      @map("description_en")
  purchaseMode       PurchaseMode @default(DIRECT) @map("purchase_mode")
  hybridThresholdQty Int?         @map("hybrid_threshold_qty")
  price              Decimal      @db.Decimal(12, 2)
  promoPrice         Decimal?     @db.Decimal(12, 2) @map("promo_price")
  currency           String       @default("MAD")
  weightKg           Decimal?     @db.Decimal(10, 3) @map("weight_kg")
  volumeMl           Decimal?     @db.Decimal(10, 2) @map("volume_ml")
  packaging          String?
  unitsPerCarton     Int?         @map("units_per_carton")
  originCountry      String?      @map("origin_country")
  ingredients        String?
  allergens          String?
  nutritionInfo      Json?        @map("nutrition_info")
  storageConditions  String?      @map("storage_conditions")
  stockQty           Int          @default(0) @map("stock_qty")
  isActive           Boolean      @default(true) @map("is_active")
  isFeatured         Boolean      @default(false) @map("is_featured")
  isNew              Boolean      @default(false) @map("is_new")
  ratingsAvg         Decimal      @default(0) @db.Decimal(3, 2) @map("ratings_avg")
  ratingsCount       Int          @default(0) @map("ratings_count")
  salesCount         Int          @default(0) @map("sales_count")
  keywords           String[]     @default([])
  seoTitleFr         String?      @map("seo_title_fr")
  seoTitleEn         String?      @map("seo_title_en")
  seoDescriptionFr   String?      @map("seo_description_fr")
  seoDescriptionEn   String?      @map("seo_description_en")
  ogImageUrl         String?      @map("og_image_url")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  lots     ProductLot[]
  cartItems CartItem[]
  orderItems OrderItem[]
  quoteItems QuoteItem[]
  reviews    Review[]
  favorites  Favorite[]
  stockAlerts StockAlert[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([isNew])
  @@index([purchaseMode])
  @@index([originCountry])
  @@index([price])
  @@index([ratingsAvg, ratingsCount])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  sku        String   @unique
  nameFr     String   @map("name_fr")
  nameEn     String   @map("name_en")
  attributes Json?
  price      Decimal? @db.Decimal(12, 2)
  stockQty   Int      @default(0) @map("stock_qty")
  weightKg   Decimal? @db.Decimal(10, 3) @map("weight_kg")
  imageUrl   String?  @map("image_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  lots       ProductLot[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  quoteItems QuoteItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  altFr     String?  @map("alt_fr")
  altEn     String?  @map("alt_en")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductLot {
  id         String    @id @default(cuid())
  productId  String    @map("product_id")
  variantId  String?   @map("variant_id")
  lotNumber  String    @map("lot_number")
  expiryDate DateTime  @map("expiry_date")
  quantity   Int
  alertedAt  DateTime? @map("alerted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, lotNumber])
  @@index([expiryDate])
  @@index([variantId])
  @@map("product_lots")
}

enum PromoType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  CMI
  BANK_TRANSFER
  STRIPE
  COD
}

enum DeliveryMode {
  STANDARD
  EXPRESS
  PICKUP
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  type          PromoType
  value         Decimal   @db.Decimal(12, 2)
  minOrderAmount Decimal? @db.Decimal(12, 2) @map("min_order_amount")
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  carts  Cart[]
  orders Order[]

  @@map("promo_codes")
}

model Cart {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  currency     String   @default("MAD")
  promoCodeId  String?  @map("promo_code_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model ShippingZone {
  id        String           @id @default(cuid())
  name      String
  type      ShippingZoneType
  country   String           @default("MA")
  /// Codes ville/région/zone (ex: ["casablanca","rabat"] ou ["casablanca-settat"])
  codes     String[]         @default([])
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  rates ShippingRate[]

  @@index([type])
  @@index([country])
  @@map("shipping_zones")
}

model ShippingRate {
  id             String       @id @default(cuid())
  name           String
  zoneId         String?      @map("zone_id")
  city           String?
  region         String?
  country        String       @default("MA")
  minWeightKg    Decimal      @default(0) @db.Decimal(10, 3) @map("min_weight_kg")
  maxWeightKg    Decimal?     @db.Decimal(10, 3) @map("max_weight_kg")
  minOrderAmount Decimal      @default(0) @db.Decimal(12, 2) @map("min_order_amount")
  price          Decimal      @db.Decimal(12, 2)
  currency       String       @default("MAD")
  deliveryMode   DeliveryMode @default(STANDARD) @map("delivery_mode")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  zone ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([region])
  @@index([country])
  @@index([zoneId])
  @@map("shipping_rates")
}

enum ShippingZoneType {
  CITY
  REGION
  ZONE
  COUNTRY
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED
  CANCELLED
}

model Carrier {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique
  trackingUrlTemplate String?  @map("tracking_url_template")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  shipments Shipment[]

  @@map("carriers")
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @map("order_id")
  carrierId      String?        @map("carrier_id")
  carrierName    String         @map("carrier_name")
  trackingNumber String         @map("tracking_number")
  trackingUrl    String?        @map("tracking_url")
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?      @map("shipped_at")
  deliveredAt    DateTime?      @map("delivered_at")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model Order {
  id                 String        @id @default(cuid())
  number             String        @unique
  userId             String        @map("user_id")
  quoteId            String?       @unique @map("quote_id")
  status             OrderStatus   @default(PENDING_PAYMENT)
  currency           String        @default("MAD")
  subtotal           Decimal       @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  taxRate            Decimal       @db.Decimal(5, 2) @map("tax_rate")
  taxAmount          Decimal       @db.Decimal(12, 2) @map("tax_amount")
  shippingFee        Decimal       @default(0) @db.Decimal(12, 2) @map("shipping_fee")
  total              Decimal       @db.Decimal(12, 2)
  promoCodeId        String?       @map("promo_code_id")
  promoCodeSnapshot  String?       @map("promo_code_snapshot")
  paymentMethod      PaymentMethod @map("payment_method")
  deliveryMode       DeliveryMode  @default(STANDARD) @map("delivery_mode")
  shippingAddressId  String?       @map("shipping_address_id")
  billingAddressId   String?       @map("billing_address_id")
  shippingAddressSnap Json         @map("shipping_address_snap")
  billingAddressSnap Json?         @map("billing_address_snap")
  customerNote       String?       @map("customer_note")
  adminNote          String?       @map("admin_note")
  carrierName        String?       @map("carrier_name")
  trackingNumber     String?       @map("tracking_number")
  shippedAt          DateTime?     @map("shipped_at")
  deliveredAt        DateTime?     @map("delivered_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancelReason       String?       @map("cancel_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user      User                  @relation(fields: [userId], references: [id])
  quote     Quote?                @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  promoCode PromoCode?            @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  history   OrderStatusHistory[]
  documents OrderDocument[]
  payments  Payment[]
  shipments Shipment[]
  returns   ReturnRequest[]
  refunds   Refund[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id")
  sku        String
  nameFr     String   @map("name_fr")
  nameEn     String   @map("name_en")
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2) @map("unit_price")
  lineTotal  Decimal  @db.Decimal(12, 2) @map("line_total")
  weightKg   Decimal? @db.Decimal(10, 3) @map("weight_kg")

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus  OrderStatus @map("to_status")
  note      String?
  changedBy String?     @map("changed_by")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

enum OrderDocumentType {
  INVOICE
  DELIVERY_NOTE
  PROFORMA
  RECEIPT
  CREDIT_NOTE
  PURCHASE_ORDER
}

model OrderDocument {
  id        String            @id @default(cuid())
  orderId   String            @map("order_id")
  type      OrderDocumentType
  fileUrl   String            @map("file_url")
  locale    Locale            @default(FR)
  createdAt DateTime          @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type])
  @@map("order_documents")
}

enum QuoteStatus {
  REQUESTED
  IN_REVIEW
  SENT
  MODIFICATION_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quote {
  id                  String      @id @default(cuid())
  number              String      @unique
  userId              String      @map("user_id")
  status              QuoteStatus @default(REQUESTED)
  destinationCountry  String      @map("destination_country")
  companyName         String?     @map("company_name")
  contactName         String?     @map("contact_name")
  contactEmail        String?     @map("contact_email")
  contactPhone        String?     @map("contact_phone")
  companyAddress      String?     @map("company_address")
  taxId               String?     @map("tax_id")
  ice                 String?
  desiredDeadline     DateTime?   @map("desired_deadline")
  message             String?
  currency            String      @default("MAD")
  subtotal            Decimal?    @db.Decimal(12, 2)
  discount            Decimal     @default(0) @db.Decimal(12, 2)
  taxRate             Decimal?    @db.Decimal(5, 2) @map("tax_rate")
  taxAmount           Decimal?    @db.Decimal(12, 2) @map("tax_amount")
  shippingFee         Decimal     @default(0) @db.Decimal(12, 2) @map("shipping_fee")
  total               Decimal?    @db.Decimal(12, 2)
  validityDate        DateTime?   @map("validity_date")
  conditions          String?
  adminNote           String?     @map("admin_note")
  clientModificationNote String?  @map("client_modification_note")
  pdfUrl              String?     @map("pdf_url")
  sentAt              DateTime?   @map("sent_at")
  respondedAt         DateTime?   @map("responded_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id])
  items        QuoteItem[]
  attachments  QuoteAttachment[]
  history      QuoteStatusHistory[]
  order        Order?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model QuoteItem {
  id         String   @id @default(cuid())
  quoteId    String   @map("quote_id")
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id")
  sku        String
  nameFr     String   @map("name_fr")
  nameEn     String   @map("name_en")
  packaging  String?
  quantity   Int
  unitPrice  Decimal? @db.Decimal(12, 2) @map("unit_price")
  lineTotal  Decimal? @db.Decimal(12, 2) @map("line_total")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  quote   Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteAttachment {
  id        String   @id @default(cuid())
  quoteId   String   @map("quote_id")
  fileUrl   String   @map("file_url")
  fileName  String?  @map("file_name")
  mimeType  String?  @map("mime_type")
  sizeBytes Int?     @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_attachments")
}

model QuoteStatusHistory {
  id         String       @id @default(cuid())
  quoteId    String       @map("quote_id")
  fromStatus QuoteStatus? @map("from_status")
  toStatus   QuoteStatus  @map("to_status")
  note       String?
  changedBy  String?      @map("changed_by")
  createdAt  DateTime     @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_status_history")
}

enum PaymentStatus {
  PENDING
  AWAITING_PROOF
  PROOF_SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id           String         @id @default(cuid())
  orderId      String         @map("order_id")
  provider     PaymentMethod
  status       PaymentStatus  @default(PENDING)
  amount       Decimal        @db.Decimal(12, 2)
  currency     String         @default("MAD")
  providerRef  String?        @map("provider_ref")
  proofUrl     String?        @map("proof_url")
  failureReason String?       @map("failure_reason")
  metadata     Json?
  paidAt       DateTime?      @map("paid_at")
  confirmedBy  String?        @map("confirmed_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([provider])
  @@index([status])
  @@map("payments")
}

model PaymentSetting {
  id        String        @id @default(cuid())
  provider  PaymentMethod @unique
  isEnabled Boolean       @default(false) @map("is_enabled")
  labelFr   String        @map("label_fr")
  labelEn   String        @map("label_en")
  config    Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("payment_settings")
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  AWAITING_RETURN_SHIPMENT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  DAMAGED_IN_TRANSIT
  NEAR_EXPIRY
  NOT_AS_DESCRIBED
  OTHER
}

enum RefundType {
  FULL
  PARTIAL
  CREDIT_NOTE
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ReturnRequest {
  id                   String       @id @default(cuid())
  number               String       @unique
  orderId              String       @map("order_id")
  userId               String       @map("user_id")
  status               ReturnStatus @default(REQUESTED)
  reason               ReturnReason
  comment              String?
  adminNote            String?      @map("admin_note")
  rejectionReason      String?      @map("rejection_reason")
  returnCarrierName    String?      @map("return_carrier_name")
  returnTrackingNumber String?      @map("return_tracking_number")
  reviewedAt           DateTime?    @map("reviewed_at")
  reviewedById         String?      @map("reviewed_by_id")
  receivedAt           DateTime?    @map("received_at")
  completedAt          DateTime?    @map("completed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id])
  items   ReturnItem[]
  photos  ReturnPhoto[]
  refunds Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("returns")
}

model ReturnItem {
  id          String @id @default(cuid())
  returnId    String @map("return_id")
  orderItemId String @map("order_item_id")
  quantity    Int
  reason      ReturnReason?
  note        String?

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnPhoto {
  id        String   @id @default(cuid())
  returnId  String   @map("return_id")
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_photos")
}

model Refund {
  id          String       @id @default(cuid())
  number      String       @unique
  returnId    String?      @map("return_id")
  orderId     String       @map("order_id")
  paymentId   String?      @map("payment_id")
  type        RefundType
  status      RefundStatus @default(PENDING)
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("MAD")
  reason      String?
  creditNoteUrl String?    @map("credit_note_url")
  processedAt DateTime?    @map("processed_at")
  processedById String?    @map("processed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  returnRequest ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

enum LegalPageType {
  CGV
  PRIVACY
  SHIPPING
  RETURNS
  LEGAL
  COOKIES
}

enum BannerPlacement {
  HOME_HERO
  HOME_SECONDARY
  CATALOG_TOP
  CHECKOUT
}

model Review {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  userId     String   @map("user_id")
  orderId    String?  @map("order_id")
  rating     Int
  title      String?
  comment    String?
  isApproved Boolean  @default(false) @map("is_approved")
  isVisible  Boolean  @default(true) @map("is_visible")
  moderatedAt DateTime? @map("moderated_at")
  moderatedById String? @map("moderated_by_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos  ReviewPhoto[]

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@map("reviews")
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photos")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

model StockAlert {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  productId  String    @map("product_id")
  email      String?
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("stock_alerts")
}

model BlogPost {
  id               String    @id @default(cuid())
  slugFr           String    @unique @map("slug_fr")
  slugEn           String    @unique @map("slug_en")
  titleFr          String    @map("title_fr")
  titleEn          String    @map("title_en")
  excerptFr        String?   @map("excerpt_fr")
  excerptEn        String?   @map("excerpt_en")
  contentFr        String    @map("content_fr") @db.Text
  contentEn        String    @map("content_en") @db.Text
  coverUrl         String?   @map("cover_url")
  seoTitleFr       String?   @map("seo_title_fr")
  seoTitleEn       String?   @map("seo_title_en")
  seoDescriptionFr String?   @map("seo_description_fr")
  seoDescriptionEn String?   @map("seo_description_en")
  isPublished      Boolean   @default(false) @map("is_published")
  publishedAt      DateTime? @map("published_at")
  authorId         String?   @map("author_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

model FaqItem {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String   @db.Text
  locale    Locale   @default(FR)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locale])
  @@index([category])
  @@index([isActive])
  @@map("faq_items")
}

model LegalPage {
  id        String        @id @default(cuid())
  type      LegalPageType
  locale    Locale        @default(FR)
  slug      String
  title     String
  content   String        @db.Text
  isPublished Boolean     @default(true) @map("is_published")
  updatedById String?     @map("updated_by_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([type, locale])
  @@unique([slug, locale])
  @@index([isPublished])
  @@map("legal_pages")
}

model Banner {
  id         String          @id @default(cuid())
  placement  BannerPlacement
  titleFr    String?         @map("title_fr")
  titleEn    String?         @map("title_en")
  subtitleFr String?         @map("subtitle_fr")
  subtitleEn String?         @map("subtitle_en")
  imageUrl   String          @map("image_url")
  linkUrl    String?         @map("link_url")
  sortOrder  Int             @default(0) @map("sort_order")
  isActive   Boolean         @default(true) @map("is_active")
  startsAt   DateTime?       @map("starts_at")
  endsAt     DateTime?       @map("ends_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([placement])
  @@index([isActive])
  @@map("banners")
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String               @id @default(cuid())
  topic     String
  name      String
  email     String
  company   String?
  phone     String?
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  readAt    DateTime?            @map("read_at")

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_messages")
}

